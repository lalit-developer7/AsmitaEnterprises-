@page "/Error"
@using System.Diagnostics

<PageTitle>Error | Asmita Enterprises</PageTitle>

<div class="container py-5 text-center my-5">
    <h1 class="text-danger fw-bold">Error</h1>
    <p class="lead text-secondary">An unexpected error occurred.</p>
    <a href="/" class="btn btn-primary rounded-pill px-4 mt-3">Return to Home</a>
</div>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id;
}
