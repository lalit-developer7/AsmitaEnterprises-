@inject LanguageService Lang
@inject WhatsAppService WA
@implements IDisposable

<section id="home" class="hero-section py-4 py-lg-5 overflow-hidden">
  <div class="container-xl">
    <div class="row align-items-center g-4 g-lg-5">
      <!-- Left Column: Headlines, Benefits & CTAs -->
      <div class="col-lg-6">
        <div class="hero-content pe-lg-3">
          <h1 class="hero-headline display-4 fw-black text-navy mb-2">
            <span class="d-block text-primary">@Lang.GetText("Hero_Title_Line1")</span>
            <span class="d-block text-navy">@Lang.GetText("Hero_Title_Line2")</span>
          </h1>

          <p class="hero-subtitle lead text-secondary fw-semibold mb-4">
            @Lang.GetText("Hero_Subtitle")
          </p>

          <!-- 4 Key Benefits Grid -->
          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <div class="d-flex align-items-start gap-2">
                <div class="benefit-icon-wrapper flex-shrink-0 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M10.067.87a2.89 2.89 0 0 0-4.134 0l-.622.638-.89-.011a2.89 2.89 0 0 0-2.924 2.924l.01.89-.636.622a2.89 2.89 0 0 0 0 4.134l.637.622-.011.89a2.89 2.89 0 0 0 2.924 2.924l.89-.01.622.636a2.89 2.89 0 0 0 4.134 0l.622-.637.89.011a2.89 2.89 0 0 0 2.924-2.924l-.01-.89.636-.622a2.89 2.89 0 0 0 0-4.134l-.637-.622.011-.89a2.89 2.89 0 0 0-2.924-2.924l-.89.01-.622-.636zm.287 5.984-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7 8.793l2.646-2.647a.5.5 0 0 1 .708.708z"/>
                  </svg>
                </div>
                <span class="small fw-semibold text-dark">@Lang.GetText("Hero_Point1")</span>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="d-flex align-items-start gap-2">
                <div class="benefit-icon-wrapper flex-shrink-0 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.48 1.48 0 0 1 1.01 1.201c.642 4.827-.916 8.321-2.67 10.615a12.22 12.22 0 0 1-2.607 2.548c-.402.285-.772.502-1.077.647a4.347 4.347 0 0 1-.418.17 1.46 1.46 0 0 1-.87 0 4.316 4.316 0 0 1-.418-.17c-.305-.145-.675-.362-1.077-.647a12.219 12.219 0 0 1-2.607-2.548C2.084 10.952.526 7.458 1.168 2.631a1.48 1.48 0 0 1 1.01-1.2A62.776 62.776 0 0 1 5.072.56z"/>
                    <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8 8.293l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                  </svg>
                </div>
                <span class="small fw-semibold text-dark">@Lang.GetText("Hero_Point2")</span>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="d-flex align-items-start gap-2">
                <div class="benefit-icon-wrapper flex-shrink-0 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7zm1.294 7.456A1.999 1.999 0 0 1 4.732 11h5.536a2.01 2.01 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456zM12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12v4zm-9 1a1 1 0 1 0 0 2 1 1 0 0 1 0-2zm9 0a1 1 0 1 0 0 2 1 1 0 0 1 0-2z"/>
                  </svg>
                </div>
                <span class="small fw-semibold text-dark">@Lang.GetText("Hero_Point3")</span>
              </div>
            </div>

            <div class="col-sm-6">
              <div class="d-flex align-items-start gap-2">
                <div class="benefit-icon-wrapper flex-shrink-0 text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8 8 0 1 1 8 0v1z"/>
                    <path d="M7.5 3a.5.5 0 0 1 .5.5v4.293l2.854 2.853a.5.5 0 0 1-.708.708l-3-3A.5.5 0 0 1 7 8V3.5a.5.5 0 0 1 .5-.5z"/>
                  </svg>
                </div>
                <span class="small fw-semibold text-dark">@Lang.GetText("Hero_Point4")</span>
              </div>
            </div>
          </div>

          <!-- Hero Action Buttons -->
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <a href="tel:+919834555868" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
              </svg>
              <span>@Lang.GetText("CTA_CallNow")</span>
            </a>

            <a href="@WA.GetGeneralEnquiryUrl(Lang.CurrentLanguage)" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg px-4 rounded-pill shadow-sm text-white d-inline-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.779-.114.133-.23.148-.427.05-.197-.099-.832-.307-1.586-.98-.588-.524-.985-1.171-1.1-1.368-.115-.198-.013-.306.086-.404.089-.088.197-.23.296-.346.099-.115.133-.197.197-.329.065-.133.033-.247-.017-.346-.05-.099-.445-1.072-.61-1.466-.16-.384-.323-.332-.445-.338-.114-.007-.247-.007-.38-.007s-.346.05-.527.247c-.182.198-.691.676-.691 1.65 0 .973.708 1.912.807 2.044.099.133 1.395 2.13 3.38 2.984.472.203.84.324 1.127.416.474.152.905.13 1.246.08.38-.058 1.17-.478 1.338-.94.168-.463.168-.86.117-.941-.051-.082-.183-.133-.38-.232z"/>
              </svg>
              <span>@Lang.GetText("CTA_WhatsApp")</span>
            </a>

            <a href="@WA.GetFreeDemoUrl(Lang.CurrentLanguage)" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-lg px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11 2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h6zM5 1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2H5z"/>
                <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
              </svg>
              <span>@Lang.GetText("CTA_FreeDemo")</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Neutral Water Purifier Visual -->
      <div class="col-lg-6">
        <div class="hero-visual-wrapper text-center">
          <img src="images/hero-purifier.jpg" alt="Asmita Enterprises Neutral Water Purifier System" class="img-fluid hero-image filter-drop-shadow" width="600" height="450" />
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
