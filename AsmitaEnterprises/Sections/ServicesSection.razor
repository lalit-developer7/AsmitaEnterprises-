@inject LanguageService Lang
@inject SiteContentService Site
@inject WhatsAppService WA
@implements IDisposable

<section id="services" class="services-section py-5 bg-sky-light">
  <div class="container-xl">
    <div class="text-center mb-5">
      <h2 class="section-heading text-navy fw-black text-uppercase tracking-wide">
        @Lang.GetText("Services_Heading")
      </h2>
      <div class="heading-line mx-auto bg-primary rounded"></div>
    </div>

    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3 g-md-4">
      @foreach (var item in Site.GetServices())
      {
        <div class="col">
          <div class="card h-100 service-card border-0 rounded-4 shadow-sm text-center p-3 transition-all bg-white d-flex flex-column justify-content-between">
            <div>
              <div class="service-icon-box text-primary mx-auto mb-3 d-flex align-items-center justify-content-center bg-sky-light rounded-circle" style="width: 56px; height: 56px;">
                @if (item.IconType == "wrench")
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M.102 2.223A3.004 3.004 0 0 0 3.78 5.897l6.341 6.252A3.003 3.003 0 0 0 13 16a3 3 0 1 0-.851-5.878L5.897 3.78A3.004 3.004 0 0 0 2.223.102L3.83 1.709 2.414 3.125.102 2.223zm13.197 10.42a1.5 1.5 0 1 1 2.122-2.122 1.5 1.5 0 0 1-2.122 2.122z"/>
                  </svg>
                }
                else if (item.IconType == "cog")
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
                    <path d="M9.799.14c-.042-.17-.184-.298-.358-.3a11.96 11.96 0 0 0-2.882 0c-.174.002-.316.13-.358.3l-.33 1.33c-.352.122-.686.284-.997.481l-1.27-.478a.35.35 0 0 0-.41.119 12.012 12.012 0 0 0-1.44 2.493.35.35 0 0 0 .1.413l1.042.846a6.602 6.602 0 0 0-.083 1.107c0 .373.03.744.083 1.107l-1.043.846a.35.35 0 0 0-.1.413 12.016 12.016 0 0 0 1.44 2.493.35.35 0 0 0 .41.119l1.27-.478c.311.197.645.359.997.481l.33 1.33c.042.17.184.298.358.3a11.956 11.956 0 0 0 2.882 0c.174-.002.316-.13.358-.3l.33-1.33c.352-.122.686-.284.997-.481l1.27.478a.35.35 0 0 0 .41-.119 12.016 12.016 0 0 0 1.44-2.493.35.35 0 0 0-.1-.413l-1.043-.846c.053-.363.083-.734.083-1.107 0-.373-.03-.744-.083-1.107l1.043-.846a.35.35 0 0 0 .1-.413 12.012 12.012 0 0 0-1.44-2.493.35.35 0 0 0-.41-.119l-1.27.478a6.59 6.59 0 0 0-.997-.481l-.33-1.33z"/>
                  </svg>
                }
                else if (item.IconType == "filter")
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M1.5 1.5A.5.5 0 0 1 2 1h12a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-.128.334L10 8.692V13.5a.5.5 0 0 1-.342.474l-3 1A.5.5 0 0 1 6 14.5V8.692L1.628 3.834A.5.5 0 0 1 1.5 3.5v-2zm1 .5v1.308l4.372 4.858A.5.5 0 0 1 7 8.5v5.306l2-.666V8.5a.5.5 0 0 1 .128-.334L13.5 3.308V2h-11z"/>
                  </svg>
                }
                else if (item.IconType == "tools")
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M1 0 0 1l2.2 3.081a1 1 0 0 0 .815.419h.07a1 1 0 0 1 .708.293l2.675 2.675-2.617 2.654A3.003 3.003 0 0 0 0 13a3 3 0 1 0 5.878-.851l2.654-2.617 2.675 2.675a1 1 0 0 1 .293.707v.07a1 1 0 0 0 .419.815L15 16l1-1-3.081-2.2a1 1 0 0 0-.419-.815v-.07a1 1 0 0 1-.293-.708L9.53 8.532l2.617-2.654A3.003 3.003 0 0 0 16 3a3 3 0 1 0-5.878.851L7.468 6.468 4.793 3.793a1 1 0 0 1-.293-.707v-.07a1 1 0 0 0-.419-.815L1 0zm1.5 1.79 1.1 1.54c.15.21.395.334.655.334h.07a2 2 0 0 0 1.414-.586l2.176-2.176a2.003 2.003 0 0 1 2.828 0l.2.2a2.003 2.003 0 0 1 0 2.828l-2.176 2.176a2 2 0 0 0-.586 1.414v.07c0 .26.124.505.334.655l1.54 1.1 1.79-1.79-1.54-1.1a1 1 0 0 0-.655-.334h-.07a2 2 0 0 1-1.414-.586L8.532 3.53a2.003 2.003 0 0 1 0-2.828l.2-.2a2.003 2.003 0 0 1 2.828 0l2.176 2.176c.375.375.586.884.586 1.414v.07c0 .26-.124.505-.334.655l-1.1 1.54L15.21 8.21"/>
                  </svg>
                }
                else if (item.IconType == "shield-check")
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.48 1.48 0 0 1 1.01 1.201c.642 4.827-.916 8.321-2.67 10.615a12.22 12.22 0 0 1-2.607 2.548c-.402.285-.772.502-1.077.647a4.347 4.347 0 0 1-.418.17 1.46 1.46 0 0 1-.87 0 4.316 4.316 0 0 1-.418-.17c-.305-.145-.675-.362-1.077-.647a12.219 12.219 0 0 1-2.607-2.548C2.084 10.952.526 7.458 1.168 2.631a1.48 1.48 0 0 1 1.01-1.2A62.776 62.776 0 0 1 5.072.56z"/>
                    <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L8 8.293l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                  </svg>
                }
                else
                {
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M6 12.5a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5zm-5-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5zm0-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5zm4-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5z"/>
                  </svg>
                }
              </div>
              <h3 class="h6 fw-bold text-navy mb-2">@Lang.GetText(item.NameKey)</h3>
              <p class="extra-small text-secondary mb-3">@Lang.GetText(item.DescriptionKey)</p>
            </div>
            <div>
              <a href="@WA.GetServiceEnquiryUrl(Lang.GetText(item.NameKey), Lang.CurrentLanguage)" target="_blank" rel="noopener noreferrer" class="btn btn-link btn-xs p-0 text-decoration-none fw-semibold text-primary">
                <span>@Lang.GetText("CTA_BookService") &rarr;</span>
              </a>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
