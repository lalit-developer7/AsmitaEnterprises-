@inject LanguageService Lang
@inject ReviewService Reviews
@inject SiteContentService Site
@implements IDisposable

<section id="reviews" class="reviews-section py-5 bg-sky-light">
  <div class="container-xl">
    <div class="text-center mb-5">
      <h2 class="section-heading text-navy fw-black text-uppercase tracking-wide">
        @Lang.GetText("Reviews_Heading")
      </h2>
      <div class="heading-line mx-auto bg-primary rounded"></div>
    </div>

    <div class="row align-items-stretch g-4">
      <!-- Left Google Rating Box -->
      <div class="col-lg-3">
        <div class="card h-100 border-0 rounded-4 shadow-sm p-4 text-center bg-white d-flex flex-column align-items-center justify-content-center">
          <!-- Google Logo -->
          <svg xmlns="http://www.w3.org/2000/svg" width="70" height="28" viewBox="0 0 74 24" class="mb-2">
            <path fill="#4285F4" d="M9.24 11.45V8.19h8.84c.09.47.14.97.14 1.54 0 5.37-3.6 9.18-9.13 9.18A9.74 9.74 0 0 1 0 9.17 9.74 9.74 0 0 1 9.24 0c2.61 0 4.8 0.96 6.47 2.52l-2.48 2.47c-1.02-.98-2.39-1.57-3.99-1.57-3.41 0-6.19 2.82-6.19 6.28s2.78 6.28 6.19 6.28c3.21 0 4.96-2.02 5.31-3.53H9.24z"/>
            <path fill="#EA4335" d="M24.71 6.32c3.42 0 6.04 2.65 6.04 6.16s-2.62 6.16-6.04 6.16c-3.41 0-6.04-2.65-6.04-6.16s2.63-6.16 6.04-6.16zm0 9.87c1.86 0 3.33-1.51 3.33-3.71s-1.47-3.71-3.33-3.71c-1.86 0-3.33 1.51-3.33 3.71s1.47 3.71 3.33 3.71z"/>
            <path fill="#FBBC05" d="M38.16 6.32c3.42 0 6.04 2.65 6.04 6.16s-2.62 6.16-6.04 6.16c-3.41 0-6.04-2.65-6.04-6.16s2.63-6.16 6.04-6.16zm0 9.87c1.86 0 3.33-1.51 3.33-3.71s-1.47-3.71-3.33-3.71c-1.86 0-3.33 1.51-3.33 3.71s1.47 3.71 3.33 3.71z"/>
            <path fill="#4285F4" d="M51.29 6.32c3.34 0 5.7 2.5 5.7 6.16 0 3.63-2.36 6.16-5.7 6.16-1.74 0-3.13-.79-3.74-1.73h-.09v1.44c0 2.37-1.27 3.64-3.31 3.64-1.67 0-2.7-1.2-3.12-2.22l2.36-.98c.33.78.97 1.66 2.08 1.66 1.34 0 2.18-.83 2.18-2.42V16.7c-.63.74-2.02 1.48-3.71 1.48-3.34 0-5.7-2.52-5.7-6.16 0-3.66 2.36-6.16 5.7-6.16 1.69 0 3.08.74 3.71 1.46h.09V6.62h3.69v-0.3zm-.26 9.87c1.86 0 3.23-1.51 3.23-3.71s-1.37-3.71-3.23-3.71c-1.86 0-3.23 1.51-3.23 3.71s1.37 3.71 3.23 3.71z"/>
            <path fill="#34A853" d="M59.1 0h3.69v18.16H59.1V0z"/>
            <path fill="#EA4335" d="M70.36 6.32c2.91 0 5.14 1.95 5.86 4.67l-3.38 1.4c-.46-1.1-1.46-1.77-2.48-1.77-1.42 0-2.61 1.13-2.61 3.33 0 2.15 1.19 3.33 2.61 3.33 1.02 0 1.95-.62 2.4-1.63l3.38 1.4c-.72 2.63-3.03 4.54-5.78 4.54-3.52 0-6.19-2.65-6.19-6.16s2.67-6.16 6.19-6.16z"/>
          </svg>

          <span class="display-5 fw-black text-navy mb-1">@Site.Settings.RatingScore</span>

          <!-- 5 Gold Stars -->
          <div class="stars text-warning h5 mb-1">
            &#9733;&#9733;&#9733;&#9733;&#9733;
          </div>

          <span class="small text-muted mb-3">(@Site.Settings.ReviewCountDisplay)</span>

          <a href="@Site.Settings.GoogleBusinessUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm d-inline-flex align-items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5z"/></svg>
            @Lang.GetText("CTA_ViewAllReviews")
          </a>
        </div>
      </div>

      <!-- Right 3 Customer Reviews Cards -->
      <div class="col-lg-9">
        <div class="row row-cols-1 row-cols-md-3 g-3 h-100">
          @foreach (var rev in Reviews.GetReviews())
          {
            <div class="col">
              <div class="card h-100 border-0 rounded-4 shadow-sm p-3 bg-white d-flex flex-column justify-content-between">
                <div>
                  <!-- Header: Avatar, Name, Time, Google Logo -->
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <div class="avatar-circle text-white fw-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px; background-color: @rev.AvatarBgColor;">
                        @rev.Initial
                      </div>
                      <div>
                        <h3 class="h6 fw-bold text-navy mb-0 extra-small">@rev.AuthorName</h3>
                        <span class="extra-small text-muted d-block">@rev.TimeAgo</span>
                      </div>
                    </div>
                    <div class="google-mini-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Stars -->
                  <div class="stars text-warning small mb-2">
                    &#9733;&#9733;&#9733;&#9733;&#9733;
                  </div>

                  <!-- Review Body -->
                  <p class="extra-small text-secondary mb-0 line-clamp-4">
                    "@rev.Comment"
                  </p>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
