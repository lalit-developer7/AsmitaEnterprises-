@inject LanguageService Lang
@inject WhatsAppService WA
@implements IDisposable

<section id="why-us" class="demo-and-area-section py-5 bg-white">
  <div class="container-xl">
    <div class="row g-4">
      <!-- Left Column: FREE WATER FILTER DEMO -->
      <div class="col-lg-7">
        <div class="card h-100 border-0 rounded-4 shadow-sm bg-sky-light p-4 p-md-5 position-relative overflow-hidden">
          <div class="row align-items-center g-3">
            <div class="col-md-7">
              <span class="badge bg-primary text-white px-3 py-2 rounded-pill small fw-semibold text-uppercase mb-3 d-inline-block">
                @Lang.GetText("Demo_Heading")
              </span>
              <h3 class="h4 fw-bold text-navy mb-3">
                @Lang.GetText("Demo_Question")
              </h3>
              <p class="text-secondary small mb-2">
                @Lang.GetText("Demo_Subtext1")
              </p>
              <p class="text-secondary small mb-4">
                @Lang.GetText("Demo_Subtext2")
              </p>
              
              <a href="@WA.GetFreeDemoUrl(Lang.CurrentLanguage)" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M11 2a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h6zM5 1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2H5z"/>
                  <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                </svg>
                <span>@Lang.GetText("CTA_BookFreeDemo")</span>
              </a>
            </div>

            <div class="col-md-5 text-center">
              <img src="images/demo-purifier.svg" alt="Free Water Filter Demo Asmita Enterprises" class="img-fluid demo-img" width="260" height="200" />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: SERVICE AREA -->
      <div class="col-lg-5">
        <div class="card h-100 border-0 rounded-4 shadow-sm p-4 p-md-5" style="background-color: #fefce8; border: 1px solid #fef08a !important;">
          <h3 class="h5 fw-black text-navy text-uppercase tracking-wide mb-4">
            @Lang.GetText("Area_Heading")
          </h3>

          <!-- Local Area: Pune & Pimpri-Chinchwad -->
          <div class="mb-4 pb-3 border-bottom border-warning border-opacity-25">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="text-warning-dark">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2 13.5V7h1v6.5a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5V7h1v6.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5zm3.146-9.354a.5.5 0 0 1 .708 0L8 6.293l2.146-2.147a.5.5 0 0 1 .708.708l-2.5 2.5a.5.5 0 0 1-.708 0l-2.5-2.5a.5.5 0 0 1 0-.708z"/>
                    <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 2 7.5V14a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7.5a.5.5 0 0 0-.146-.354l-6-6zM2.5 7.707 8 2.207l5.5 5.5V14H10v-4a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v4H2.5V7.707z"/>
                  </svg>
                </div>
                <h4 class="h6 fw-bold text-navy mb-0">@Lang.GetText("Area_Local_Title")</h4>
              </div>
              <div class="text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                  <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                </svg>
              </div>
            </div>
            <ul class="list-unstyled mb-0 extra-small text-secondary ps-4">
              <li>• @Lang.GetText("Area_Local_Point1")</li>
              <li>• @Lang.GetText("Area_Local_Point2")</li>
              <li>• @Lang.GetText("Area_Local_Point3")</li>
            </ul>
          </div>

          <!-- Other Cities -->
          <div>
            <div class="d-flex align-items-center justify-content-between mb-2">
              <div class="d-flex align-items-center gap-2">
                <div class="text-warning-dark">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7z"/>
                  </svg>
                </div>
                <h4 class="h6 fw-bold text-navy mb-0">@Lang.GetText("Area_Other_Title")</h4>
              </div>
              <div class="text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                  <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                </svg>
              </div>
            </div>
            <ul class="list-unstyled mb-0 extra-small text-secondary ps-4">
              <li>• @Lang.GetText("Area_Other_Point1")</li>
              <li>• @Lang.GetText("Area_Other_Point2")</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
