@inject LanguageService Lang
@inject SiteContentService Site
@inject WhatsAppService WA
@implements IDisposable

<section id="contact" class="contact-section py-5 text-white" style="background-color: #0a2540;">
  <div class="container-xl">
    <div class="row g-4">
      <!-- Left Column: Contact Details -->
      <div class="col-lg-6">
        <div class="pe-lg-4">
          <h2 class="h3 fw-black text-uppercase tracking-wide mb-4">
            @Lang.GetText("Contact_Heading")
          </h2>

          <div class="d-flex flex-column gap-3 mb-4">
            <!-- Phone -->
            <div class="d-flex align-items-center gap-3">
              <div class="contact-icon-box text-primary bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
                </svg>
              </div>
              <div>
                <span class="d-block extra-small text-light text-opacity-75">Phone / WhatsApp</span>
                <a href="tel:+919834555868" class="text-white text-decoration-none fw-bold h6 mb-0">@Site.Settings.PhonePrimary</a>
              </div>
            </div>

            <!-- Email -->
            <div class="d-flex align-items-center gap-3">
              <div class="contact-icon-box text-primary bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                </svg>
              </div>
              <div>
                <span class="d-block extra-small text-light text-opacity-75">Email</span>
                <a href="mailto:@Site.Settings.Email" class="text-white text-decoration-none fw-bold h6 mb-0">@Site.Settings.Email</a>
              </div>
            </div>

            <!-- Owner -->
            <div class="d-flex align-items-center gap-3">
              <div class="contact-icon-box text-primary bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                </svg>
              </div>
              <div>
                <span class="d-block extra-small text-light text-opacity-75">@Lang.GetText("Contact_OwnerLabel")</span>
                <span class="fw-bold h6 mb-0 text-white">@Site.Settings.OwnerName</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Office Address & Map CTA -->
      <div class="col-lg-6">
        <div class="ps-lg-4 border-start-lg border-white border-opacity-10">
          <h2 class="h3 fw-black text-uppercase tracking-wide mb-4">
            @Lang.GetText("Contact_OfficeHeading")
          </h2>

          <div class="d-flex align-items-start gap-3 mb-4">
            <div class="contact-icon-box text-primary bg-white bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
              </svg>
            </div>
            <div>
              <span class="fw-bold h6 d-block mb-1 text-white">@Site.Settings.BusinessName</span>
              <p class="small text-light text-opacity-75 mb-3">
                @Site.Settings.Address
              </p>
              <a href="@Site.Settings.GoogleMapsUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm px-4 rounded-pill shadow-sm d-inline-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M15.817.113A.5.5 0 0 0 15.3 0L1.05 4.55a.5.5 0 0 0-.064.95l5.886 2.354 2.354 5.886a.5.5 0 0 0 .95-.064L15.887.7a.5.5 0 0 0-.07-.587z"/>
                </svg>
                <span>@Lang.GetText("CTA_GetDirections")</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
