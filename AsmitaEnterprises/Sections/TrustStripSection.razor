@inject LanguageService Lang
@inject SiteContentService Site
@implements IDisposable

<section class="trust-strip py-3 bg-white border-bottom">
  <div class="container-xl">
    <div class="row row-cols-2 row-cols-md-4 g-2 g-md-3 align-items-center text-center">
      <!-- Item 1: Products Delivered -->
      <div class="col">
        <div class="stat-box py-2 px-1 d-flex flex-column align-items-center rounded-3">
          <div class="stat-icon-wrap mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
              <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7z"/>
            </svg>
          </div>
          <span class="stat-number h5 fw-black text-navy mb-0">@Site.Settings.ProductsDelivered</span>
          <span class="stat-label extra-small fw-semibold text-muted">@Lang.GetText("Stat_ProductsDelivered")</span>
        </div>
      </div>

      <!-- Item 2: Google Rating -->
      <div class="col">
        <div class="stat-box py-2 px-1 d-flex flex-column align-items-center rounded-3">
          <div class="stat-icon-wrap mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-warning" viewBox="0 0 16 16">
              <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
            </svg>
          </div>
          <span class="stat-number h5 fw-black text-navy mb-0">@Site.Settings.RatingScore</span>
          <span class="stat-label extra-small fw-semibold text-muted">@Lang.GetText("Stat_GoogleRating")</span>
        </div>
      </div>

      <!-- Item 3: Customer Satisfaction -->
      <div class="col">
        <div class="stat-box py-2 px-1 d-flex flex-column align-items-center rounded-3">
          <div class="stat-icon-wrap mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-success" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
            </svg>
          </div>
          <span class="stat-number h5 fw-black text-navy mb-0">@Site.Settings.CustomerSatisfaction</span>
          <span class="stat-label extra-small fw-semibold text-muted">@Lang.GetText("Stat_CustomerSatisfaction")</span>
        </div>
      </div>

      <!-- Item 4: Location Coverage -->
      <div class="col">
        <div class="stat-box py-2 px-1 d-flex flex-column align-items-center rounded-3">
          <div class="stat-icon-wrap mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
              <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
            </svg>
          </div>
          <span class="stat-number h6 fw-bold text-navy mb-0">@Site.Settings.PrimaryServiceArea</span>
          <span class="stat-label extra-small fw-semibold text-muted">@Lang.GetText("Stat_ServiceLocation")</span>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
