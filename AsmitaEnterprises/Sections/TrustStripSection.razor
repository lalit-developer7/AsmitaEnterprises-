@inject LanguageService Lang
@inject SiteContentService Site
@implements IDisposable

<section class="trust-strip py-4 bg-sky-light border-top border-bottom">
  <div class="container-xl">
    <div class="row row-cols-2 row-cols-md-4 g-3 align-items-center text-center">
      <!-- Item 1: Products Delivered -->
      <div class="col">
        <div class="stat-box p-2 d-flex flex-column align-items-center">
          <div class="stat-icon text-primary mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2l-2.218-.887zm3.564 1.426L5.596 5 8 5.961 14.154 3.5l-2.404-.961zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.84L1 4.239v7.923l6.5 2.6zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1.5 1.5 0 0 1-.901 1.37l-6.5 2.6a1.5 1.5 0 0 1-1.198 0l-6.5-2.6A1.5 1.5 0 0 1 0 12.162V3.5a.5.5 0 0 1 .314-.464L7.443.184z"/>
            </svg>
          </div>
          <span class="stat-number h3 fw-black text-navy mb-0">@Site.Settings.ProductsDelivered</span>
          <span class="stat-label small fw-semibold text-muted">@Lang.GetText("Stat_ProductsDelivered")</span>
        </div>
      </div>

      <!-- Item 2: Google Rating -->
      <div class="col">
        <div class="stat-box p-2 d-flex flex-column align-items-center">
          <div class="stat-icon text-warning mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
              <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
            </svg>
          </div>
          <span class="stat-number h3 fw-black text-navy mb-0">@Site.Settings.RatingScore</span>
          <span class="stat-label small fw-semibold text-muted">@Lang.GetText("Stat_GoogleRating")</span>
        </div>
      </div>

      <!-- Item 3: Customer Satisfaction -->
      <div class="col">
        <div class="stat-box p-2 d-flex flex-column align-items-center">
          <div class="stat-icon text-success mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
              <path d="M4.285 9.567a.5.5 0 0 1 .683.183A3.498 3.498 0 0 0 8 11.5c1.29 0 2.448-.69 3.032-1.75a.5.5 0 1 1 .866.5A4.498 4.498 0 0 1 8 12.5a4.498 4.498 0 0 1-3.898-2.25.5.5 0 0 1 .183-.683zM7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5zm4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5z"/>
            </svg>
          </div>
          <span class="stat-number h3 fw-black text-navy mb-0">@Site.Settings.CustomerSatisfaction</span>
          <span class="stat-label small fw-semibold text-muted">@Lang.GetText("Stat_CustomerSatisfaction")</span>
        </div>
      </div>

      <!-- Item 4: Location Coverage -->
      <div class="col">
        <div class="stat-box p-2 d-flex flex-column align-items-center">
          <div class="stat-icon text-primary mb-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
              <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
            </svg>
          </div>
          <span class="stat-number h6 fw-bold text-navy mb-0 mt-1">@Site.Settings.PrimaryServiceArea</span>
          <span class="stat-label extra-small fw-semibold text-muted">@Lang.GetText("Stat_ServiceLocation")</span>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }
}
